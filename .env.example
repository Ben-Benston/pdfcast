# Neon Postgres Database Connection String (Required)
# From Neon Dashboard -> Project -> Connection Details
DATABASE_URL=postgresql://[user]:[password]@[endpoint].us-east-2.aws.neon.tech/neondb?sslmode=require

# Neon Object Storage (Optional - if using the 'pdfs' bucket in Neon Object Storage)
# Neon Dashboard -> Object Storage -> S3 Credentials
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=pdfs

# Vercel Cron Secret (Optional)
CRON_SECRET=
